{
  "name": "robot-scrape-products",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "start:local": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publish:event": "./scripts/publish-event.sh",
    "publish:event:dry-run": "./scripts/publish-event.sh --dry-run",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "postinstall": "npx camoufox-js fetch || true"
  },
  "dependencies": {
    "camoufox-js": "^0.11.2",
    "ioredis": "^5.6.1",
    "playwright-core": "1.60.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
